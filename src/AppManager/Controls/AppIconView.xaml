<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AppManager.Controls.AppIconView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border x:Name="Tile" BorderThickness="1">
        <Grid>
            <Image x:Name="IconImage" Stretch="Uniform"
                   ImageFailed="IconImage_ImageFailed" />
            <FontIcon x:Name="FallbackIcon" Glyph="{x:Bind FallbackGlyph, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock x:Name="FallbackLetter" Text="{x:Bind FallbackText, Mode=OneWay}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" />
        </Grid>
    </Border>
</UserControl>
