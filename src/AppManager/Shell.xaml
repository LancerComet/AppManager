<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AppManager.Shell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:AppManager.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                Content="{l:Loc Key=Nav_Overview}"
                Tag="overview">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D2;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="{l:Loc Key=Nav_Apps}" Tag="apps">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE71D;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="{l:Loc Key=Nav_Harnesses}" Tag="harnesses">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE99A;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="{l:Loc Key=Nav_DevTools}" Tag="devtools">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEC7A;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="{l:Loc Key=Nav_Unattributed}" Tag="unattributed">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Frame x:Name="NavFrame" />
    </NavigationView>
</UserControl>
