<Page
    x:Class="AppManager.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AppManager.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:AppManager.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="ContentScroller"
        Padding="24,16,24,24"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentPanel" Spacing="{StaticResource PageBlockSpacing}">
            <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="设置" />

            <StackPanel Spacing="{StaticResource SectionContentSpacing}">
                <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="外观" />
                <Border
                    MinHeight="64"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE790;" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Text="主题" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="选择应用外观" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThemeBox"
                            Grid.Column="2"
                            MinWidth="140"
                            VerticalAlignment="Center"
                            SelectionChanged="ThemeBox_SelectionChanged">
                            <ComboBoxItem Content="系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionContentSpacing}">
                <TextBlock
                    Margin="{StaticResource SectionHeaderTopMargin}"
                    Style="{StaticResource SectionHeaderTextBlockStyle}"
                    Text="扫描" />
                <Border
                    MinHeight="64"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE721;" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Text="隐藏低置信度匹配" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="在应用列表中不显示名称相近等低置信度的文件夹归属" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind Settings.HideLowConfidence, Mode=TwoWay}"
                            OffContent="关"
                            OnContent="开"
                            Style="{StaticResource RightAlignedCompactToggleSwitchStyle}" />
                    </Grid>
                </Border>
                <Border
                    MinHeight="64"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8DA;" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Text="自定义扫描目录" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="除内置位置外，额外扫描这些目录下的内容" />
                        </StackPanel>
                        <Button
                            x:Name="AddRootButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="AddRoot_Click"
                            Content="添加文件夹" />
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{x:Bind Settings.ExtraRoots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,4"
                                Padding="16,12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE8B7;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{Binding}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="RemoveRoot_Click"
                                        Content="移除" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionContentSpacing}">
                <TextBlock
                    Margin="{StaticResource SectionHeaderTopMargin}"
                    Style="{StaticResource SectionHeaderTextBlockStyle}"
                    Text="关于" />
                <Border
                    MinHeight="64"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/AppIcon.ico" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Text="AppManager" />
                            <TextBlock
                                x:Name="AboutVersion"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="分析各磁盘空间占用并归属到已安装程序。仅查看与分析，不提供删除功能。" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
