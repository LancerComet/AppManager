<Page
    x:Class="AppManager.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AppManager.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:AppManager.Services"
    xmlns:l="using:AppManager.Localization"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="ContentScroller"
        Padding="24,16,24,24"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentPanel" Spacing="{StaticResource PageBlockSpacing}">
            <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="{l:Loc Key=Settings_Title}" />

            <StackPanel Spacing="{StaticResource SectionContentSpacing}">
                <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="{l:Loc Key=Settings_Appearance}" />
                <Border
                    MinHeight="64"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE790;" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Text="{l:Loc Key=Settings_Theme}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{l:Loc Key=Settings_ThemeDesc}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThemeBox"
                            Grid.Column="2"
                            MinWidth="140"
                            VerticalAlignment="Center"
                            SelectionChanged="ThemeBox_SelectionChanged">
                            <ComboBoxItem Content="{l:Loc Key=Theme_System}" />
                            <ComboBoxItem Content="{l:Loc Key=Theme_Light}" />
                            <ComboBoxItem Content="{l:Loc Key=Theme_Dark}" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border
                    MinHeight="64"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE774;" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Text="{l:Loc Key=Settings_Language}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{l:Loc Key=Settings_LanguageDesc}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="LanguageBox"
                            Grid.Column="2"
                            MinWidth="140"
                            VerticalAlignment="Center"
                            SelectionChanged="LanguageBox_SelectionChanged">
                            <ComboBoxItem Content="{l:Loc Key=Lang_FollowSystem}" />
                            <ComboBoxItem Content="简体中文" />
                            <ComboBoxItem Content="繁體中文" />
                            <ComboBoxItem Content="日本語" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionContentSpacing}">
                <TextBlock
                    Margin="{StaticResource SectionHeaderTopMargin}"
                    Style="{StaticResource SectionHeaderTextBlockStyle}"
                    Text="{l:Loc Key=Settings_Scan}" />
                <Border
                    MinHeight="64"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE721;" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Text="{l:Loc Key=Settings_HideLow}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{l:Loc Key=Settings_HideLowDesc}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind Settings.HideLowConfidence, Mode=TwoWay}"
                            OffContent="{l:Loc Key=Toggle_Off}"
                            OnContent="{l:Loc Key=Toggle_On}"
                            Style="{StaticResource RightAlignedCompactToggleSwitchStyle}" />
                    </Grid>
                </Border>
                <Border
                    MinHeight="64"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8DA;" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Text="{l:Loc Key=Settings_ExtraRoots}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{l:Loc Key=Settings_ExtraRootsDesc}" />
                        </StackPanel>
                        <Button
                            x:Name="AddRootButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="AddRoot_Click"
                            Content="{l:Loc Key=Settings_AddFolder}" />
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{x:Bind Settings.ExtraRoots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,4"
                                Padding="16,12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE8B7;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{Binding}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="RemoveRoot_Click"
                                        Content="{l:Loc Key=Settings_Remove}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionContentSpacing}">
                <TextBlock
                    Margin="{StaticResource SectionHeaderTopMargin}"
                    Style="{StaticResource SectionHeaderTextBlockStyle}"
                    Text="{l:Loc Key=Settings_About}" />
                <Border
                    MinHeight="64"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/Square44x44Logo.png" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Text="AppManager" />
                            <TextBlock
                                x:Name="AboutVersion"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{l:Loc Key=Settings_AboutDesc}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
