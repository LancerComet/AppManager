<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AppManager.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppManager.ViewModels"
    xmlns:services="using:AppManager.Services"
    xmlns:controls="using:AppManager.Controls"
    xmlns:l="using:AppManager.Localization"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Page.Resources>
        <services:DoubleToGridLengthConverter x:Key="ToGridLength" />
        <services:NullToVisibilityConverter x:Key="NullToVis" />
        <services:BoolToVisibilityConverter x:Key="BoolToVis" />
        <services:ConfidenceToBrushConverter x:Key="ConfBrush" />
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource PageBlockSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="{l:Loc Key=Apps_Title}" />

        <!-- Toolbar -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" PlaceholderText="{l:Loc Key=Apps_SearchPlaceholder}" Width="260"
                         Height="32" TextWrapping="NoWrap" AcceptsReturn="False"
                         TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="SortBox" SelectedIndex="0" Width="160"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="{l:Loc Key=Apps_SortTotal}" />
                    <ComboBoxItem Content="{l:Loc Key=Apps_SortData}" />
                    <ComboBoxItem Content="{l:Loc Key=Apps_SortInstall}" />
                    <ComboBoxItem Content="{l:Loc Key=Apps_SortName}" />
                </ComboBox>
                <ComboBox x:Name="SourceBox" SelectedIndex="0" Width="140"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="{l:Loc Key=Apps_SourceAll}" />
                    <ComboBoxItem Content="{l:Loc Key=Apps_SourceRegistry}" />
                    <ComboBoxItem Content="{l:Loc Key=Apps_SourceMsix}" />
                    <ComboBoxItem Content="{l:Loc Key=Apps_SourceTool}" />
                </ComboBox>
                <CheckBox x:Name="HideLowCheck" Content="{l:Loc Key=Apps_HideLowConfidence}"
                          IsChecked="{x:Bind Settings.HideLowConfidence, Mode=TwoWay}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Content="{l:Loc Key=Apps_Export}" Click="Export_Click" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="{StaticResource MasterDetailSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="380" />
                <ColumnDefinition Width="3*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="ItemsList" SelectionMode="Single"
                      SelectionChanged="ItemsList_SelectionChanged"
                      ItemContainerStyle="{StaticResource AppListViewItemStyle}"
                      ItemsSource="{x:Bind Items}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppItemViewModel">
                        <Grid ColumnSpacing="12" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:AppIconView Icon="{x:Bind Icon, Mode=OneWay}"
                                                  FallbackGlyph="{x:Bind IconGlyph}"
                                                  FallbackText="{x:Bind IconLetter}"
                                                  TileSize="36" TileCornerRadius="8"
                                                  VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid>
                                        <TextBlock Text="{x:Bind PublisherText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                                    Visibility="{x:Bind IsEstimated, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{l:Loc Key=Apps_BadgeEstimated}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind IsTool, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{l:Loc Key=Apps_BadgeTool}" FontSize="12" />
                                            </Border>
                                            <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    Visibility="{x:Bind HasLowConfidence, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{l:Loc Key=Apps_BadgeLowConf}" FontSize="12"
                                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <Grid Height="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind BarStars, Converter={StaticResource ToGridLength}}" />
                                        <ColumnDefinition Width="{x:Bind RestStars, Converter={StaticResource ToGridLength}}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind InstallStars, Converter={StaticResource ToGridLength}}" />
                                            <ColumnDefinition Width="{x:Bind DataStars, Converter={StaticResource ToGridLength}}" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="2,0,0,2" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Border Grid.Column="1" CornerRadius="0,2,2,0" Background="{ThemeResource AccentFillColorSecondaryBrush}" />
                                    </Grid>
                                </Grid>
                                <TextBlock Text="{x:Bind FolderCountText}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind TotalText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Detail pane -->
            <ScrollViewer Grid.Column="1" x:Name="DetailPane" Margin="0,2,0,0"
                          Padding="{StaticResource ScrollbarContentPadding}"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DetailStack" Spacing="12">
                    <Grid ColumnSpacing="16" x:Name="DetailEmpty">
                        <TextBlock Text="{l:Loc Key=Apps_SelectHint}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <StackPanel x:Name="DetailContent" Visibility="Collapsed">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:AppIconView x:Name="DetailIconView"
                                                  TileSize="64" TileCornerRadius="12" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="DetailName" Style="{ThemeResource SubtitleTextBlockStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailPublisher"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="DetailVersion" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="InstallRow" ColumnSpacing="12" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Loc Key=Apps_InstallLocation}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="DetailInstall"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="OpenInstallButton" Content="{l:Loc Key=Apps_OpenInstallLocation}"
                                    VerticalAlignment="Center" Click="OpenInstall_Click" />
                        </Grid>

                        <Grid ColumnSpacing="8" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="12,10" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{l:Loc Key=Apps_TotalLabel}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="DetailTotal" FontWeight="SemiBold" FontSize="18" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="12,10" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{l:Loc Key=Apps_InstallLabel}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="DetailInstallBytes" FontWeight="SemiBold" FontSize="18" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="12,10" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{l:Loc Key=Apps_DataLabel}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="DetailDataBytes" FontWeight="SemiBold" FontSize="18" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ItemsControl x:Name="DrivePillList" Margin="0,8,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,2" Margin="0,0,6,4" CornerRadius="4"
                                            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                        <TextBlock Text="{Binding}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="DetailEstimatedNote" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />

                        <TextBlock Text="{l:Loc Key=Apps_FoldersHeader}" Style="{StaticResource SectionHeaderTextBlockStyle}"
                                   Margin="0,24,0,0" />
                        <ItemsControl x:Name="FolderList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FolderRowViewModel">
                                    <Border Padding="16,12" Margin="0,0,0,6" MinHeight="76" CornerRadius="6"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="8">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind CategoryLabel}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <Border Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                                                Background="{x:Bind Confidence, Converter={StaticResource ConfBrush}}">
                                                            <TextBlock Text="{x:Bind ConfidenceText}" FontSize="12"
                                                                       Foreground="{x:Bind Confidence, Converter={StaticResource ConfBrush}, ConverterParameter=fg}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Path}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind Path}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{x:Bind HasLastWrite, Converter={StaticResource BoolToVis}}">
                                                            <Run Text="{l:Loc Key=Common_LastModified}" /><Run Text="{x:Bind LastWriteText}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{x:Bind Reason}" FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind InaccessibleText}" FontSize="12"
                                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                   Visibility="{x:Bind HasInaccessible, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Grid Height="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{x:Bind SizeStars, Converter={StaticResource ToGridLength}}" />
                                                        <ColumnDefinition Width="{x:Bind RestStars, Converter={StaticResource ToGridLength}}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind SizeText}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" />
                                                <Button Content="{l:Loc Key=Common_Open}" Command="{x:Bind OpenInExplorerCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
