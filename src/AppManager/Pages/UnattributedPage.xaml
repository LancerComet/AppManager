<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AppManager.Pages.UnattributedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppManager.ViewModels"
    xmlns:services="using:AppManager.Services"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Page.Resources>
        <services:DoubleToGridLengthConverter x:Key="ToGridLength" />
        <services:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="未识别文件夹" />

        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="这些文件夹没有找到对应的已安装程序，可能是卸载残留、便携软件或命令行工具产生的数据。" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
            <TextBox x:Name="SearchBox" PlaceholderText="搜索路径" Width="260"
                     Height="32" TextWrapping="NoWrap" AcceptsReturn="False"
                     TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="CategoryBox" Width="220" SelectedIndex="0"
                      SelectionChanged="CategoryBox_SelectionChanged" />
        </StackPanel>

        <ListView Grid.Row="3" x:Name="ItemsList" ItemsSource="{x:Bind Items}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:UnattributedItemViewModel">
                    <Grid ColumnSpacing="12" Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <Grid>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <Border Padding="6,2" CornerRadius="4"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            Visibility="{x:Bind MaybeStale, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="可能残留" FontSize="12"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind Path}" /><Run Text="·" /><Run Text="{x:Bind CategoryLabel}" />
                                <Run Text="·" /><Run Text="{x:Bind LastWriteText}" />
                            </TextBlock>
                            <Grid Height="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind SizeStars, Converter={StaticResource ToGridLength}}" />
                                    <ColumnDefinition Width="{x:Bind RestStars, Converter={StaticResource ToGridLength}}" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="2" Background="{ThemeResource AccentFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind SizeText}" HorizontalAlignment="Right" />
                            <Button Content="打开位置" Padding="8,2" FontSize="11"
                                    Command="{x:Bind OpenInExplorerCommand}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
