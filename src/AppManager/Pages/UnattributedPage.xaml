<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AppManager.Pages.UnattributedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppManager.ViewModels"
    xmlns:services="using:AppManager.Services"
    xmlns:l="using:AppManager.Localization"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Page.Resources>
        <services:DoubleToGridLengthConverter x:Key="ToGridLength" />
        <services:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource PageBlockSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="{l:Loc Key=Unattr_Title}" />

        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{l:Loc Key=Unattr_Description}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="SearchBox" PlaceholderText="{l:Loc Key=Unattr_SearchPlaceholder}" Width="260"
                     Height="32" TextWrapping="NoWrap" AcceptsReturn="False"
                     TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="CategoryBox" Width="220" SelectedIndex="0"
                      SelectionChanged="CategoryBox_SelectionChanged" />
        </StackPanel>

        <ListView Grid.Row="3" x:Name="ItemsList" ItemsSource="{x:Bind Items}"
                  ItemContainerStyle="{StaticResource AppListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:UnattributedItemViewModel">
                    <Grid ColumnSpacing="12" Padding="0,12" MinHeight="76">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            Visibility="{x:Bind MaybeStale, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{l:Loc Key=Unattr_MaybeStale}" FontSize="12"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Path}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Path}" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Border Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                        <TextBlock Text="{x:Bind CategoryLabel}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind HasLastWrite, Converter={StaticResource BoolToVis}}">
                                        <Run Text="{l:Loc Key=Common_LastModified}" /><Run Text="{x:Bind LastWriteText}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind InaccessibleText}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               Visibility="{x:Bind HasInaccessible, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                            <Grid Height="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind SizeStars, Converter={StaticResource ToGridLength}}" />
                                    <ColumnDefinition Width="{x:Bind RestStars, Converter={StaticResource ToGridLength}}" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="2" Background="{ThemeResource AccentFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <Button Content="{l:Loc Key=Common_OpenLocation}" Command="{x:Bind OpenInExplorerCommand}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
