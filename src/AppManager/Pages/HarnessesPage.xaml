<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AppManager.Pages.HarnessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppManager.ViewModels"
    xmlns:services="using:AppManager.Services"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Page.Resources>
        <services:DoubleToGridLengthConverter x:Key="ToGridLength" />
        <services:NullToVisibilityConverter x:Key="NullToVis" />
        <services:BoolToVisibilityConverter x:Key="BoolToVis" />
        <services:NotBoolConverter x:Key="NotBool" />
        <services:HarnessKindToBrushConverter x:Key="KindBrush" />
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource PageBlockSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="AI 工具" />

        <!-- Toolbar -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="SubtitleText" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            Visibility="{x:Bind Session.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressRing Width="20" Height="20" IsIndeterminate="True" />
                    <TextBlock Text="正在统计 AI 工具数据…" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="重新扫描" Click="Rescan_Click" VerticalAlignment="Center"
                    IsEnabled="{x:Bind Session.IsScanning, Mode=OneWay, Converter={StaticResource NotBool}}"/>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="{StaticResource MasterDetailSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="380" />
                <ColumnDefinition Width="3*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Grid>
                <ListView x:Name="ItemsList" SelectionMode="Single"
                          SelectionChanged="ItemsList_SelectionChanged"
                          ItemContainerStyle="{StaticResource AppListViewItemStyle}"
                          ItemsSource="{x:Bind Items}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HarnessItemViewModel">
                            <Grid ColumnSpacing="12" Padding="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32" VerticalAlignment="Center">
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform"
                                           ImageFailed="ItemIcon_ImageFailed" />
                                    <Border CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind Icon, Mode=OneWay, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                                        <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="14" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Grid Height="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind BarStars, Converter={StaticResource ToGridLength}}" />
                                            <ColumnDefinition Width="{x:Bind RestStars, Converter={StaticResource ToGridLength}}" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind TotalText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Text="未发现 AI 工具留下的数据" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </Grid>

            <!-- Detail pane -->
            <ScrollViewer Grid.Column="1" x:Name="DetailPane" Margin="0,2,0,0"
                          Padding="{StaticResource ScrollbarContentPadding}"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DetailStack" Spacing="12">
                    <Grid ColumnSpacing="16" x:Name="DetailEmpty">
                        <TextBlock Text="选择左侧的工具查看详情" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <StackPanel x:Name="DetailContent" Visibility="Collapsed">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="64" Height="64">
                                <Image x:Name="DetailIcon" Stretch="Uniform"
                                       ImageFailed="DetailIcon_ImageFailed" />
                                <Border x:Name="DetailIconFallback" CornerRadius="10"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon x:Name="DetailIconGlyph" FontSize="24" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="DetailName" Style="{ThemeResource SubtitleTextBlockStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailPublisher"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="总计 " /><Run x:Name="DetailTotal" FontWeight="SemiBold" />
                                    <Run x:Name="DetailExcluded" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="按类型" Style="{StaticResource SectionHeaderTextBlockStyle}"
                                   Margin="0,24,0,0" />
                        <ItemsControl x:Name="KindList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HarnessKindRowViewModel">
                                    <Grid ColumnSpacing="12" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind Kind, Converter={StaticResource KindBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Grid Grid.Column="2" VerticalAlignment="Center" Height="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind BarStars, Converter={StaticResource ToGridLength}}" />
                                                <ColumnDefinition Width="{x:Bind RestStars, Converter={StaticResource ToGridLength}}" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="3"
                                                    Background="{x:Bind Kind, Converter={StaticResource KindBrush}}" />
                                        </Grid>
                                        <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" FontSize="12"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="文件夹与文件" Style="{StaticResource SectionHeaderTextBlockStyle}"
                                   Margin="0,24,0,0" />
                        <ItemsControl x:Name="EntryGroups" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HarnessKindGroupViewModel">
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{x:Bind HeaderText}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{x:Bind Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HarnessEntryViewModel">
                                                    <Border Padding="16,12" Margin="0,0,0,6" MinHeight="76" CornerRadius="6"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" Spacing="8">
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind Path}" FontSize="12"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTipService.ToolTip="{x:Bind Path}" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                                                        <TextBlock FontSize="12"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                   Visibility="{x:Bind HasLastWrite, Converter={StaticResource BoolToVis}}">
                                                                            <Run Text="修改于 " /><Run Text="{x:Bind LastWriteText}" />
                                                                        </TextBlock>
                                                                        <TextBlock Text="{x:Bind FileCountText}" FontSize="12"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Grid Height="4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{x:Bind SizeStars, Converter={StaticResource ToGridLength}}" />
                                                                        <ColumnDefinition Width="{x:Bind RestStars, Converter={StaticResource ToGridLength}}" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                                                </Grid>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                                                                        HorizontalAlignment="Right">
                                                                <TextBlock Text="{x:Bind SizeText}" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Right" />
                                                                <Button Content="打开" Command="{x:Bind OpenInExplorerCommand}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
