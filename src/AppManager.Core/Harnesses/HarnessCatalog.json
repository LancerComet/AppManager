        { "path": "%USERPROFILE%\\.claude.json*", "kind": "state" },
        { "path": "%USERPROFILE%\\.local\\share\\claude\\versions", "kind": "versions" },
        { "path": "%USERPROFILE%\\.local\\state\\claude", "kind": "state" },
        { "path": "%USERPROFILE%\\.cache\\claude", "kind": "cache" },
        { "path": "%LOCALAPPDATA%\\claude-cli-nodejs", "kind": "cache" }
      ]
    },
    {
      "id": "claude-desktop",
      "name": "Claude 桌面版",
      "publisher": "Anthropic",
      "type": "desktop",
      "iconApp": "^Claude$",
