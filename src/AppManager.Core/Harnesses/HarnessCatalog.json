            { "match": "jobs", "kind": "conversations" },
            { "match": "history.jsonl", "kind": "conversations" },
            { "match": "file-history", "kind": "snapshots" },
            { "match": "backups", "kind": "snapshots" },
            { "match": "shell-snapshots", "kind": "cache" },
            { "match": "cache", "kind": "cache" },
            { "match": "statsig", "kind": "cache" },
            { "match": "paste-cache", "kind": "cache" },
            { "match": "image-cache", "kind": "cache" },
