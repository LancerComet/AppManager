{
  "presets": {
    "electron": [
      { "match": "Cache", "kind": "cache" },
      { "match": "Code Cache", "kind": "cache" },
      { "match": "GPUCache", "kind": "cache" },
      { "match": "GrShaderCache", "kind": "cache" },
      { "match": "ShaderCache", "kind": "cache" },
      { "match": "DawnCache", "kind": "cache" },
      { "match": "DawnGraphiteCache", "kind": "cache" },
      { "match": "DawnWebGPUCache", "kind": "cache" },
