        {
          "path": "%USERPROFILE%\\.gradle\\caches\\build-cache-1",
          "kind": "buildCache",
          "mode": "merge",
          "label": "Gradle build cache",
          "sources": [ { "env": "GRADLE_USER_HOME", "suffix": "caches\\build-cache-1" } ]
        },
        {
          "path": "%USERPROFILE%\\.gradle\\wrapper\\dists",
          "kind": "sdk",
          "sources": [ { "env": "GRADLE_USER_HOME", "suffix": "wrapper\\dists" } ],
          "children": [ { "match": "CACHEDIR.TAG", "kind": "state" } ]
        },
        {
          "path": "%USERPROFILE%\\.gradle\\jdks",
          "kind": "sdk",
          "sources": [ { "env": "GRADLE_USER_HOME", "suffix": "jdks" } ]
        },
        {
          "path": "%USERPROFILE%\\.gradle",
          "kind": "state",
          "mode": "merge",
          "sources": [ { "env": "GRADLE_USER_HOME" } ],
          "children": [
            { "match": "caches", "kind": "cache" },
            { "match": "daemon", "kind": "logs" },
            { "match": "kotlin-profile", "kind": "logs" },
            { "match": "native", "kind": "cache" },
            { "match": "workers", "kind": "cache" },
            { "match": "android", "kind": "cache" },
            { "match": ".tmp", "kind": "cache" }
          ]
        }
      ]
    },
    {
      "id": "maven",
      "name": "Maven",
      "publisher": "Apache",
      "type": "buildTool",
      "roots": [
        {
          "path": "%USERPROFILE%\\.m2\\repository",
