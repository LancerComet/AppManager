      "publisher": "Anaconda",
      "type": "packageManager",
      "iconApp": "^(Anaconda|Miniconda|Miniforge)",
      "roots": [
        { "path": "%USERPROFILE%\\anaconda3", "kind": "sdk", "mode": "merge", "children": [ { "preset": "condaInstall" } ] },
        { "path": "%USERPROFILE%\\miniconda3", "kind": "sdk", "mode": "merge", "children": [ { "preset": "condaInstall" } ] },
        { "path": "%USERPROFILE%\\miniforge3", "kind": "sdk", "mode": "merge", "children": [ { "preset": "condaInstall" } ] },
        { "path": "%USERPROFILE%\\mambaforge", "kind": "sdk", "mode": "merge", "children": [ { "preset": "condaInstall" } ] },
        { "path": "%LOCALAPPDATA%\\anaconda3", "kind": "sdk", "mode": "merge", "children": [ { "preset": "condaInstall" } ] },
        { "path": "%LOCALAPPDATA%\\miniconda3", "kind": "sdk", "mode": "merge", "children": [ { "preset": "condaInstall" } ] },
        { "path": "%PROGRAMDATA%\\anaconda3", "kind": "sdk", "mode": "merge", "children": [ { "preset": "condaInstall" } ] },
        { "path": "%PROGRAMDATA%\\miniconda3", "kind": "sdk", "mode": "merge", "children": [ { "preset": "condaInstall" } ] },
        { "path": "%USERPROFILE%\\.conda\\pkgs", "kind": "packageCache", "mode": "merge" },
        { "path": "%USERPROFILE%\\.conda\\envs", "kind": "globalPackages" },
        { "path": "%LOCALAPPDATA%\\conda\\conda\\Cache", "kind": "cache", "mode": "merge", "label": "conda cache" }
      ]
    },
    {
      "id": "rustup",
