        { "path": "%LOCALAPPDATA%\\uv\\cache", "kind": "packageCache", "mode": "merge", "label": "uv cache", "sources": [ { "env": "UV_CACHE_DIR" } ] },
        { "path": "%APPDATA%\\uv\\python", "kind": "sdk", "sources": [ { "env": "UV_PYTHON_INSTALL_DIR" } ] },
        { "path": "%APPDATA%\\uv\\data\\python", "kind": "sdk" },
        { "path": "%APPDATA%\\uv\\tools", "kind": "globalPackages", "sources": [ { "env": "UV_TOOL_DIR" } ] },
        { "path": "%APPDATA%\\uv\\data\\tools", "kind": "globalPackages" }
      ]
    },
    {
      "id": "poetry",
