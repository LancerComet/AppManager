        { "path": "%LOCALAPPDATA%\\Python\\pythoncore-*", "kind": "sdk", "mode": "merge" },
        { "path": "%APPDATA%\\Python\\Python*", "kind": "globalPackages", "mode": "merge" },
        { "path": "%USERPROFILE%\\.pyenv\\pyenv-win\\versions", "kind": "sdk" }
      ]
    },
    {
      "id": "pip",
