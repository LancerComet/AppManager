{
  "presets": {
    "npmCache": [
      { "match": "_logs", "kind": "logs" },
      { "match": "_npx", "kind": "cache" }
    ],
    "condaInstall": [
      { "match": "pkgs", "kind": "packageCache" },
      { "match": "envs", "kind": "globalPackages" }
    ],
    "browserDownloads": [
      { "match": ".links", "kind": "state" },
      { "match": "mcp-chrome*", "kind": "state" }
    ]
  },
  "harnesses": [
    {
      "id": "dotnet",
      "name": ".NET SDK",
      "publisher": "Microsoft",
      "type": "runtime",
      "roots": [
        { "path": "%PROGRAMFILES%\\dotnet\\sdk", "kind": "sdk", "entryPrefix": ".NET SDK" },
        { "path": "%PROGRAMFILES%\\dotnet\\shared\\Microsoft.NETCore.App", "kind": "sdk", "entryPrefix": ".NET Runtime" },
        { "path": "%PROGRAMFILES%\\dotnet\\shared\\Microsoft.AspNetCore.App", "kind": "sdk", "entryPrefix": "ASP.NET Core Runtime" },
        { "path": "%PROGRAMFILES%\\dotnet\\shared\\Microsoft.WindowsDesktop.App", "kind": "sdk", "entryPrefix": "Windows Desktop Runtime" },
        {
          "path": "%PROGRAMFILES%\\dotnet",
          "kind": "sdk",
          "mode": "merge",
          "children": [
            { "match": "packs", "kind": "sdk" },
            { "match": "templates", "kind": "sdk" },
            { "match": "sdk-manifests", "kind": "sdk" }
          ]
        },
        { "path": "%PROGRAMFILES(X86)%\\dotnet\\shared\\Microsoft.NETCore.App", "kind": "sdk", "entryPrefix": ".NET Runtime (x86)" },
        { "path": "%PROGRAMFILES(X86)%\\dotnet\\shared\\Microsoft.AspNetCore.App", "kind": "sdk", "entryPrefix": "ASP.NET Core Runtime (x86)" },
        { "path": "%PROGRAMFILES(X86)%\\dotnet\\shared\\Microsoft.WindowsDesktop.App", "kind": "sdk", "entryPrefix": "Windows Desktop Runtime (x86)" },
        { "path": "%PROGRAMFILES(X86)%\\dotnet", "kind": "sdk", "mode": "merge", "label": "dotnet (x86)" },
        {
          "path": "%LOCALAPPDATA%\\Microsoft\\dotnet",
          "kind": "sdk",
          "mode": "merge",
          "sources": [ { "env": "DOTNET_ROOT" } ]
        },
        { "path": "%USERPROFILE%\\.dotnet\\tools", "kind": "globalPackages", "mode": "merge", "label": ".NET tools" },
        { "path": "%USERPROFILE%\\.templateengine", "kind": "cache", "mode": "merge" }
      ]
    },
    {
      "id": "nuget",
      "name": "NuGet",
      "publisher": "Microsoft",
      "type": "packageManager",
      "roots": [
        {
          "path": "%USERPROFILE%\\.nuget\\packages",
          "kind": "packageCache",
          "mode": "merge",
          "sources": [ { "env": "NUGET_PACKAGES" } ]
        },
        {
          "path": "%LOCALAPPDATA%\\NuGet\\v3-cache",
          "kind": "cache",
          "mode": "merge",
          "sources": [ { "env": "NUGET_HTTP_CACHE_PATH" } ]
        },
        {
          "path": "%LOCALAPPDATA%\\NuGet\\plugins-cache",
          "kind": "cache",
          "mode": "merge",
          "sources": [ { "env": "NUGET_PLUGINS_CACHE_PATH" } ]
        },
        { "path": "%LOCALAPPDATA%\\Temp\\NuGetScratch", "kind": "cache", "mode": "merge" },
        { "path": "%PROGRAMFILES(X86)%\\Microsoft SDKs\\NuGetPackages", "kind": "packageCache", "mode": "merge" }
      ]
    },
    {
      "id": "nodejs",
      "name": "Node.js",
      "publisher": "OpenJS Foundation",
      "type": "runtime",
      "iconApp": "^Node\\.js",
      "roots": [
        { "path": "%PROGRAMFILES%\\nodejs", "kind": "sdk", "mode": "merge", "label": "Node.js" },
        { "path": "%PROGRAMFILES(X86)%\\nodejs", "kind": "sdk", "mode": "merge", "label": "Node.js (x86)" },
        {
          "path": "%APPDATA%\\nvm",
          "kind": "sdk",
          "mode": "merge",
          "label": "nvm",
          "sources": [ { "env": "NVM_HOME" } ],
          "children": [ { "match": "v*", "kind": "sdk" } ]
        },
        { "path": "%APPDATA%\\fnm", "kind": "sdk", "mode": "merge", "label": "fnm", "sources": [ { "env": "FNM_DIR" } ] },
        { "path": "%LOCALAPPDATA%\\fnm", "kind": "sdk", "mode": "merge", "label": "fnm" },
        { "path": "%LOCALAPPDATA%\\Volta", "kind": "sdk", "mode": "merge", "label": "Volta", "sources": [ { "env": "VOLTA_HOME" } ] },
        { "path": "%LOCALAPPDATA%\\node-gyp\\Cache", "kind": "cache", "mode": "merge", "label": "node-gyp" }
      ]
    },
    {
      "id": "npm",
      "name": "npm",
      "publisher": "GitHub",
      "type": "packageManager",
      "roots": [
        {
          "path": "%LOCALAPPDATA%\\npm-cache",
          "kind": "packageCache",
          "mode": "merge",
          "sources": [
            { "env": "npm_config_cache" },
            { "ini": "%USERPROFILE%\\.npmrc", "key": "cache" }
          ],
          "children": [ { "preset": "npmCache" } ]
        },
        { "path": "%APPDATA%\\npm-cache", "kind": "packageCache", "mode": "merge", "children": [ { "preset": "npmCache" } ] },
        { "path": "%USERPROFILE%\\.npm", "kind": "packageCache", "mode": "merge", "children": [ { "preset": "npmCache" } ] },
        {
          "path": "%APPDATA%\\npm",
          "kind": "globalPackages",
          "mode": "merge",
          "label": "npm global",
          "sources": [
            { "env": "npm_config_prefix" },
            { "ini": "%USERPROFILE%\\.npmrc", "key": "prefix" }
          ]
        }
      ]
    },
    {
      "id": "pnpm",
      "name": "pnpm",
      "type": "packageManager",
      "roots": [
        {
          "kind": "packageCache",
          "mode": "merge",
          "label": "pnpm store",
          "sources": [
            { "env": "npm_config_store_dir" },
            { "ini": "%LOCALAPPDATA%\\pnpm\\config\\rc", "key": "store-dir" },
            { "ini": "%USERPROFILE%\\.npmrc", "key": "store-dir" }
          ]
        },
        { "path": "%DRIVES%\\.pnpm-store", "kind": "packageCache", "mode": "merge" },
        {
          "path": "%LOCALAPPDATA%\\pnpm",
          "kind": "globalPackages",
          "mode": "merge",
          "label": "pnpm",
          "sources": [ { "env": "PNPM_HOME" } ],
          "children": [
            { "match": "store", "kind": "packageCache" },
            { "match": "config", "kind": "state" }
          ]
        },
        { "path": "%LOCALAPPDATA%\\pnpm-cache", "kind": "cache", "mode": "merge" },
        { "path": "%LOCALAPPDATA%\\pnpm-state", "kind": "state", "mode": "merge" }
      ]
    },
    {
      "id": "yarn",
      "name": "Yarn",
      "type": "packageManager",
      "roots": [
        {
          "path": "%LOCALAPPDATA%\\Yarn",
          "kind": "state",
          "mode": "merge",
          "children": [
            { "match": "Cache", "kind": "packageCache" },
            { "match": "Berry", "kind": "packageCache" },
            { "match": "Data", "kind": "globalPackages" }
          ]
        },
        { "path": "%USERPROFILE%\\.yarn\\berry", "kind": "packageCache", "mode": "merge" }
      ]
    },
    {
      "id": "bun",
      "name": "Bun",
      "publisher": "Oven",
      "type": "runtime",
      "roots": [
        { "path": "%USERPROFILE%\\.bun\\install\\cache", "kind": "packageCache", "mode": "merge", "label": "Bun cache" },
        { "path": "%USERPROFILE%\\.bun\\install\\global", "kind": "globalPackages", "mode": "merge", "label": "Bun global" },
        { "path": "%USERPROFILE%\\.bun", "kind": "sdk", "mode": "merge", "label": "Bun" }
      ]
    },
    {
      "id": "deno",
      "name": "Deno",
      "type": "runtime",
      "roots": [
        { "path": "%LOCALAPPDATA%\\deno", "kind": "packageCache", "mode": "merge", "sources": [ { "env": "DENO_DIR" } ] },
        { "path": "%USERPROFILE%\\.deno", "kind": "sdk", "mode": "merge", "sources": [ { "env": "DENO_INSTALL" } ] }
      ]
    },
    {
      "id": "java",
      "name": "Java (JDK)",
      "type": "runtime",
      "iconApp": "OpenJDK|Java\\(TM\\)|Java SE Development Kit|Temurin|Zulu|Corretto",
      "roots": [
        { "path": "%PROGRAMFILES%\\Java\\*", "kind": "sdk", "mode": "merge" },
        { "path": "%PROGRAMFILES(X86)%\\Java\\*", "kind": "sdk", "mode": "merge" },
        { "path": "%PROGRAMFILES%\\Microsoft\\jdk-*", "kind": "sdk", "mode": "merge" },
        { "path": "%PROGRAMFILES%\\Eclipse Adoptium\\*", "kind": "sdk", "mode": "merge" },
        { "path": "%PROGRAMFILES%\\Zulu\\*", "kind": "sdk", "mode": "merge" },
        { "path": "%PROGRAMFILES%\\Amazon Corretto\\*", "kind": "sdk", "mode": "merge" },
        { "path": "%PROGRAMFILES%\\BellSoft\\*", "kind": "sdk", "mode": "merge" },
        { "path": "%PROGRAMFILES%\\Semeru\\*", "kind": "sdk", "mode": "merge" },
        { "path": "%USERPROFILE%\\.jdks\\*", "kind": "sdk", "mode": "merge" },
        { "kind": "sdk", "mode": "merge", "sources": [ { "env": "JAVA_HOME" } ] }
      ]
    },
    {
      "id": "gradle",
      "name": "Gradle",
      "type": "buildTool",
      "roots": [
        {
          "path": "%USERPROFILE%\\.gradle\\caches\\modules-2",
          "kind": "packageCache",
          "mode": "merge",
